# Copy to .env for local development. Never commit a real .env file.
# Every value below is a safe placeholder.

# Core server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Origin policy. The game is same-origin by default, which is correct for Render.
# Add comma separated origins only if the frontend is served elsewhere.
ALLOWED_ORIGINS=
PUBLIC_ORIGIN=
REQUIRE_ORIGIN=false
TRUST_PROXY=0
# Only needed if the game is intentionally embedded in another site.
EMBED_ORIGINS=
# Development only. Relaxes the origin check for hosted previews that rewrite the
# Host header. Ignored when NODE_ENV=production.
DEV_ALLOW_ANY_ORIGIN=false

# Match timing and cleanup
COUNTDOWN_MS=3200
ROOM_IDLE_TTL_MS=1200000
ROOM_FINISHED_TTL_MS=300000
TICK_INTERVAL_MS=500
DISCONNECT_GRACE_MS=30000

# Abuse limits
MAX_ROOMS=500
MAX_ROOMS_PER_IP=15
MAX_SOCKETS_PER_IP=12
JOIN_ATTEMPTS_PER_MINUTE=30
SEND_PER_SECOND=10
SEND_BURST=14
DEDUPE_WINDOW=400

# Sticker catalogue. Leave blank to serve public/stickers.
# STICKER_MANIFEST_URL=https://raw.githubusercontent.com/OWNER/REPO/main/stickers/manifest.json
# STICKER_ASSET_BASE=https://cdn.jsdelivr.net/gh/OWNER/REPO@main/stickers/
STICKER_MANIFEST_URL=
STICKER_ASSET_BASE=

# Legal and contact configuration. Publish a real contact before going public.
PRIVACY_CONTACT_EMAIL=
CONTACT_URL=https://github.com/myapps112233/App1/issues
OPERATOR_NAME=
LEGAL_EFFECTIVE_DATE=24 October 2026
REPO_URL=https://github.com/myapps112233/App1
